<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7EAE0"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Sunflower Yarn Logo -->

    <!-- App Name -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:contentDescription="Crocheter's Place Logo"
        android:src="@drawable/logoic" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="Crocheter's Place"
        android:textColor="#4A2C2A"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Stitch by stitch, create your magic"
        android:textColor="#7D5A50"
        android:textSize="14sp" />

</LinearLayout>